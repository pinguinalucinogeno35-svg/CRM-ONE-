# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (sb_secret_...). Somente no servidor; nunca usar prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# App da Meta (App Dashboard > App settings > Basic). Usados no login das redes
# sociais e na verificação do webhook do WhatsApp.
META_APP_ID=
META_APP_SECRET=
# Texto livre escolhido por você; o mesmo valor vai no campo "Verify token" da Meta.
META_WEBHOOK_VERIFY_TOKEN=

# Protege a atualização diária automática. Qualquer texto longo e aleatório.
CRON_SECRET=
